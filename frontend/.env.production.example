# Frontend Environment Variables for Railway
# Copy this to .env.production and configure in Railway dashboard

# API Configuration
# Replace with your actual backend API URL (deployed separately)
VITE_API_BASE_URL=https://your-backend-api.up.railway.app/api
# Or if using a custom domain:
# VITE_API_BASE_URL=https://api.university-system.com/api

# App Configuration
VITE_APP_NAME=University System
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_MPESA=true
VITE_ENABLE_HELB=true

# Pagination
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_PAGE_SIZE=100

# File Upload
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# Theme
VITE_DEFAULT_THEME=light